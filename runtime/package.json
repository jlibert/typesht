    "javascript",
    "compiler",
    "transpiler",
    "python-to-javascript",
    "type-safe"
  ],
  "author": "Jeiel K Libert",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jlibert/typesht.git",
    "directory": "runtime"
  },
  "homepage": "https://github.com/jlibert/typesht#readme",
  "bugs": {
    "url": "https://github.com/jlibert/typesht/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
