{
  "name": "typesht-runtime",
  "version": "0.1.1",
  "description": "Python behavior runtime for TypeSht — preserves Python semantics in JavaScript environments",
  "main": "typesht-runtime.js",
  "types": "typesht-runtime.d.ts",
  "exports": {
    ".": {
      "import": "./typesht-runtime.js",
      "types": "./typesht-runtime.d.ts"
    }
  },
  "files": [
    "typesht-runtime.js",
    "typesht-runtime.js.map",
    "typesht-runtime.d.ts",
    "typesht-runtime.d.ts.map"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "typesht",
    "runtime",
