# examples/hello.tsht
# A comprehensive TypeSht program demonstrating all core language features

# --- Imports ---
import math
import random
from json import dumps, loads
import os
import sys

# --- Variables ---
name: str = "Alice"
age: int = 30
score: float = 9.5
is_active: bool = True

# --- F-strings ---
greeting: str = f"Hello, {name}! You are {age} years old."
print(greeting)
print(f"Score: {score}, Active: {is_active}")

# --- Print ---
print("Hello, " + name)
print("Age:", age)

# --- If / elif / else ---
if age > 18:
    print("Adult")
elif age == 18:
    print("Just turned 18")
else:
    print("Minor")

# --- For loop with range ---
print("Counting:")
for i in range(5):
    print(i)

# --- While loop ---
x: int = 3
while x > 0:
    print(x)
    x -= 1

# --- Functions ---
def greet(person_name: str, person_age: int) -> str:
    return f"Hi, I am {person_name} and I am {person_age} years old"

print(greet(name, age))

# --- Lambda functions ---
double = lambda x: x * 2
add = lambda x, y: x + y
print(double(5))
print(add(3, 4))

# --- Generics ---
numbers: list[int] = [1, 2, 3, 4, 5]
words: list[str] = ["hello", "world"]
scores: list[float] = [9.5, 8.0, 7.5]

# --- List operations ---
items: list = [10, 20, 30, 40, 50]
print(items[0])
print(items[-1])
print(items[1:3])

# --- Dict ---
data: dict = {"lang": "TypeSht", "version": "0.1"}

# --- For in loop ---
for item in items:
    print(item)

# --- For tuple unpack ---
pairs: list = [[1, "one"], [2, "two"], [3, "three"]]
for num, word in pairs:
    print(f"{num} = {word}")

# --- Class with decorators ---
class MathHelper:
    base: int

    def __init__(self, base: int):
        self.base = base

    def multiply(self, x: int) -> int:
        return self.base * x

    @staticmethod
    def add(x: int, y: int) -> int:
        return x + y

    @classmethod
    def create(cls, base: int) -> int:
        return base

    @property
    def value(self) -> int:
        return self.base

helper = MathHelper(10)
print(helper.multiply(5))
print(MathHelper.add(3, 4))
print(helper.value)

# --- Class with __init__ ---
class Person:
    name: str
    age: int

    def __init__(self, name: str, age: int):
        self.name = name
        self.age = age

    def greet(self) -> str:
        return f"Hi, I am {self.name}"

person: Person = Person(name, age)
print(person.greet())

# --- Operators ---
result: int = 10 // 3
remainder: int = 10 % 3
power: int = 2 ** 8
print(result)
print(remainder)
print(power)

# --- Math stdlib ---
pi_val: float = math.pi
sqrt_val: float = math.sqrt(16)
print(f"pi = {pi_val}")
print(f"sqrt(16) = {sqrt_val}")

# --- JSON stdlib ---
data_str: str = dumps({"key": "value", "num": 42})
print(data_str)

# --- OS stdlib ---
joined: str = os.path.join("folder", "file.txt")
dirname: str = os.path.dirname("/some/path/file.txt")
print(joined)
print(dirname)

# --- Logical operators ---
a: bool = True
b: bool = False
print(a and b)
print(a or b)
print(not a)

# --- Comparisons ---
print(1 in numbers)
print(99 not in numbers)